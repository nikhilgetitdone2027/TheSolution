# CHEM2ENERGY local configuration.
# Copy to .env. Do not commit real secrets.

ML_SERVICE_URL=http://127.0.0.1:8000
PORT=4000

# Optional. When unset, ChemAI uses the grounded explanation engine
# and does not call an external model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional report upload. When unset, reports stay on this machine.
REPORTS_BUCKET=
AWS_REGION=
